# "" = same-origin (prod: BACKEND serves SPA from public/index.html)
# For `pnpm dev`, either leave empty and use vite proxy, or set http://localhost:8000
VITE_API_URL=

# Reverb (only if BROADCAST_DRIVER=pusher). Defaults: localhost:8080
# VITE_REVERB_APP_KEY=projectx-key
# VITE_REVERB_HOST=localhost
# VITE_REVERB_PORT=8080
# VITE_REVERB_SCHEME=http
